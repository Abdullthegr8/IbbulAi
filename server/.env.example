# ─── LLM (Groq) ─────────────────────────────────────────────────
# The model is fixed here; it can't be changed from the admin dashboard
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ─── WEB SEARCH ─────────────────────────────────────────────────
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=your_tavily_api_key_here

# ─── DATABASE ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/unibot
# Supabase: use the "Session pooler" string (Dashboard → Connect), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is on automatically for non-local hosts (DB_SSL=true|false to override).
# Supabase CA certificate (Dashboard → Database settings → SSL configuration):
DB_SSL_CA=
# Only if you can't use the CA certificate — encrypts but skips certificate checks
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── SEMANTIC SEARCH (Supabase Edge Function "embed") ──────────
# Embeddings come from supabase/functions/embed (built-in gte-small model).
# Leave empty to use keyword search only.
SUPABASE_URL=https://<project-ref>.supabase.co
EMBED_SECRET=<random 64-character string — same value as the function secret>
RAG_TOP_K=5

# ─── CLOUDINARY ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─── AUTH ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
# Staff accounts must register with an email on this domain
STAFF_EMAIL_DOMAIN=ibbu.edu.ng
# Must be changed — the server refuses to start in production with a weak password
ADMIN_PASSWORD=change_me

# ─── SERVER ─────────────────────────────────────────────────────
# 5000 is taken by AirPlay Receiver on macOS
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── FILE UPLOAD ────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
