# ─── LLM PROVIDER ───────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# OpenAI (plug-and-play alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (plug-and-play alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── WEB SEARCH ─────────────────────────────────────────────────
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=your_tavily_api_key_here

# ─── DATABASE ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/unibot
# Production only: set to false if your DB host uses a self-signed certificate
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── VECTOR DB (optional) ───────────────────────────────────────
CHROMA_HOST=http://localhost:8000
CHROMA_COLLECTION=ibbulai_knowledge
RAG_TOP_K=5

# ─── CLOUDINARY ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─── AUTH ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
# Staff accounts must register with an email on this domain
STAFF_EMAIL_DOMAIN=ibbu.edu.ng
# Must be changed — the server refuses to start in production with a weak password
ADMIN_PASSWORD=change_me

# ─── SERVER ─────────────────────────────────────────────────────
# 5000 is taken by AirPlay Receiver on macOS
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── FILE UPLOAD ────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
